# Local docker compose settings. Copy to `.env` and replace every value before the first start.
# `.env` is ignored by git; never commit real secrets.

# PostgreSQL role used by every service (one database per service).
POSTGRES_PASSWORD=change-me-postgres

# RabbitMQ user shared by the services.
RABBITMQ_PASSWORD=change-me-rabbitmq

# Keycloak bootstrap administrator (admin console on http://localhost:8080/admin).
KEYCLOAK_ADMIN_PASSWORD=change-me-keycloak

# Secret of the confidential `notification-service` client (client_credentials towards Shipment).
NOTIFICATION_CLIENT_SECRET=change-me-notification-secret

# Password of the demo accounts imported with the realm (customers, operators, administrator).
# The realm password policy applies: at least 12 characters with upper case, lower case, digit and
# special character, otherwise Keycloak refuses the import and stops.
DEMO_USER_PASSWORD=Change-Me-Demo-2026

# Image tag used for the locally built ParcelFlow images.
PARCELFLOW_TAG=local
