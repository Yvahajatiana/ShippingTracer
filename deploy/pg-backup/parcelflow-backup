#!/bin/sh
# Logical backups of the ParcelFlow databases (custom format, restorable one database at a time).
#
# Usage: parcelflow-backup now     back up once and exit
#        parcelflow-backup list    list the snapshots
#        parcelflow-backup idle    keep the container running (default command)
#
# The schedule lives on the host: deploy/dokploy/backup-demo.sh stops the gateway and waits until the
# queues and outboxes are empty before calling `now`, so that the nine dumps describe one state.
# Settings (environment): PGHOST, PGPORT, PGUSER, PGPASSWORD (libpq), BACKUP_DATABASES (space
# separated), BACKUP_RETENTION_DAYS (default 7).
# A snapshot is a directory /backups/<UTC timestamp> holding one <database>.dump per database and
# a SHA256SUMS manifest. It is written under a .partial name and renamed once complete, so an
# interrupted run never looks like a valid snapshot.
set -eu

root=/backups
databases=${BACKUP_DATABASES:-"parcelflow_customers parcelflow_shipments parcelflow_tracking parcelflow_warehouse parcelflow_delivery parcelflow_billing parcelflow_notification parcelflow_reporting keycloak"}
retention=${BACKUP_RETENTION_DAYS:-7}

log() { printf '%s parcelflow-backup: %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$*"; }
fail() {
  log "ERROR: $*" >&2
  exit 1
}

case "$retention" in
  '' | *[!0-9]*) fail "BACKUP_RETENTION_DAYS must be a whole number of days, got '$retention'." ;;
esac
[ "$retention" -ge 1 ] || fail "BACKUP_RETENTION_DAYS must be at least 1."

backup() {
  started=$(date -u +%s)
  name=$(date -u +%Y-%m-%dT%H%M%SZ)
  work="$root/$name.partial"
  rm -rf "$root"/*.partial
  mkdir "$work"
  for database in $databases; do
    pg_dump --format=custom --no-owner --no-privileges --dbname "$database" --file "$work/$database.dump" \
      || fail "pg_dump of $database failed; $work is left for inspection."
  done
  (cd "$work" && sha256sum ./*.dump > SHA256SUMS)
  mv "$work" "$root/$name"
  log "snapshot $name: $(echo $databases | wc -w) databases, $(du -sh "$root/$name" | cut -f1), $(($(date -u +%s) - started))s"
  # Retention by snapshot age; the snapshot just written is always kept.
  for old in $(find "$root" -mindepth 1 -maxdepth 1 -type d -name '????-??-??T??????Z' -mtime +"$((retention - 1))" ! -name "$name"); do
    rm -rf "$old"
    log "removed snapshot ${old##*/}"
  done
}

case "${1:-idle}" in
  now) backup ;;
  list) find "$root" -mindepth 1 -maxdepth 1 -type d -name '????-??-??T??????Z' -exec basename {} \; | sort ;;
  idle)
    log "ready: backups are triggered by backup-demo.sh on the host; $retention days kept"
    trap 'exit 0' TERM INT
    while true; do sleep 3600 & wait $!; done
    ;;
  *) echo "Usage: $0 now|list|idle" >&2; exit 2 ;;
esac
