# ParcelFlow public demo: variables of the Dokploy compose application (Environment tab).
# Dokploy writes them to deploy/dokploy/.env on the server; never commit real values.
# Required variables make `docker compose` stop with an explicit message when they are missing.

# Public domain (proxied by Cloudflare): parcelflow., app., ops., admin., api. and auth. subdomains
# are used.
DEMO_DOMAIN=example.com

# PostgreSQL role shared by the eight service databases and the Keycloak database.
POSTGRES_PASSWORD=change-me-postgres

# RabbitMQ user shared by the services.
RABBITMQ_PASSWORD=change-me-rabbitmq

# Keycloak bootstrap administrator `admin` (master realm, SSH tunnel only). Applied when the
# Keycloak database is created: first deployment or nightly reset.
KEYCLOAK_ADMIN_PASSWORD=change-me-keycloak

# Secret of the confidential `notification-service` client (client_credentials towards Shipment).
NOTIFICATION_CLIENT_SECRET=change-me-notification-secret

# Shared password of the demo accounts. It is PUBLIC: shown on the login page of every portal.
# Realm policy: at least 12 characters with upper case, lower case, digit and special character.
# No double quote or backslash: Keycloak substitutes it verbatim into the realm JSON, and the
# import (hence Keycloak) fails.
DEMO_USER_PASSWORD=Change-Me-Demo-2026

# Optional. Image tag published by the CI: latest (main), or an immutable sha-xxxxxxx.
PARCELFLOW_TAG=latest
# Optional. Registry and owner of the ParcelFlow images.
PARCELFLOW_REGISTRY=ghcr.io/yvahajatiana
# Optional. Keycloak version, identical to the local stack.
KEYCLOAK_TAG=26.8.1
# Optional. Local port of the SSH tunnel used to open the Keycloak admin console.
KEYCLOAK_ADMIN_TUNNEL_PORT=8180

# Optional. Gateway quotas per window of 60 s: every visitor reaches the gateway through the
# nginx of a portal and shares the demo accounts.
GATEWAY_PUBLIC_PERMIT_LIMIT=300
GATEWAY_PRIVATE_PERMIT_LIMIT=1200
GATEWAY_IP_PERMIT_LIMIT=3000
