        { "name": "audience-warehouse-api", "protocol": "openid-connect", "protocolMapper": "oidc-audience-mapper", "consentRequired": false, "config": { "included.custom.audience": "warehouse-api", "access.token.claim": "true", "id.token.claim": "false", "introspection.token.claim": "true" } },
        { "name": "audience-delivery-api", "protocol": "openid-connect", "protocolMapper": "oidc-audience-mapper", "consentRequired": false, "config": { "included.custom.audience": "delivery-api", "access.token.claim": "true", "id.token.claim": "false", "introspection.token.claim": "true" } },
        { "name": "audience-billing-api", "protocol": "openid-connect", "protocolMapper": "oidc-audience-mapper", "consentRequired": false, "config": { "included.custom.audience": "billing-api", "access.token.claim": "true", "id.token.claim": "false", "introspection.token.claim": "true" } },
        { "name": "audience-notification-api", "protocol": "openid-connect", "protocolMapper": "oidc-audience-mapper", "consentRequired": false, "config": { "included.custom.audience": "notification-api", "access.token.claim": "true", "id.token.claim": "false", "introspection.token.claim": "true" } },
        { "name": "audience-reporting-api", "protocol": "openid-connect", "protocolMapper": "oidc-audience-mapper", "consentRequired": false, "config": { "included.custom.audience": "reporting-api", "access.token.claim": "true", "id.token.claim": "false", "introspection.token.claim": "true" } }
      ]
    },
    {
      "clientId": "notification-service",
      "name": "Notification service",
      "description": "Confidential service account used by Notification to read shipment snapshots (client_credentials only).",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "${NOTIFICATION_CLIENT_SECRET}",
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "authorizationServicesEnabled": false,
      "consentRequired": false,
      "frontchannelLogout": false,
      "fullScopeAllowed": false,
      "redirectUris": [],
      "webOrigins": [],
      "attributes": {
        "client_credentials.use_refresh_token": "false",
        "oauth2.device.authorization.grant.enabled": "false",
        "oidc.ciba.grant.enabled": "false",
        "use.refresh.tokens": "false"
      },
      "defaultClientScopes": ["basic", "roles", "profile"],
      "optionalClientScopes": [],
      "protocolMappers": [
        { "name": "audience-shipment-api", "protocol": "openid-connect", "protocolMapper": "oidc-audience-mapper", "consentRequired": false, "config": { "included.custom.audience": "shipment-api", "access.token.claim": "true", "id.token.claim": "false", "introspection.token.claim": "true" } }
      ]
    }
  ],
  "scopeMappings": [
    { "client": "parcelflow-customer", "roles": ["customer"] },
    { "client": "parcelflow-operations", "roles": ["operator", "admin"] },
    { "client": "parcelflow-admin", "roles": ["admin"] },
