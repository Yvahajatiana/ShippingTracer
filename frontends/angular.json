{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "npm",
    "analytics": false,
    "schematicCollections": ["angular-eslint"]
  },
  "newProjectRoot": "projects",
  "projects": {
    "customer-portal": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": {
          "style": "css",
          "changeDetection": "OnPush"
        }
      },
      "root": "projects/customer-portal",
      "sourceRoot": "projects/customer-portal/src",
      "prefix": "pf",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "projects/customer-portal/src/main.ts",
            "tsConfig": "projects/customer-portal/tsconfig.app.json",
            "assets": [
              {
                "glob": "**/*",
                "input": "projects/customer-portal/public"
              },
              {
                "glob": "**/*",
                "input": "projects/shared/i18n",
                "output": "i18n/shared"
              },
              {
                "glob": "mockServiceWorker.js",
                "input": "projects/shared/public",
                "output": "/"
              }
            ],
            "styles": ["projects/customer-portal/src/styles.css"]
          },
          "configurations": {
            "production": {
              "assets": [
                {
                  "glob": "**/*",
                  "input": "projects/customer-portal/public"
                },
                {
                  "glob": "**/*",
                  "input": "projects/shared/i18n",
                  "output": "i18n/shared"
                },
                {
                  "glob": "config.json",
                  "input": "projects/customer-portal/config/production",
                  "output": "/"
                }
              ],
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "1MB",
                  "maximumError": "1.5MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "4kB",
                  "maximumError": "8kB"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "assets": [
                {
                  "glob": "**/*",
                  "input": "projects/customer-portal/public"
                },
                {
                  "glob": "**/*",
                  "input": "projects/shared/i18n",
                  "output": "i18n/shared"
                },
                {
                  "glob": "mockServiceWorker.js",
                  "input": "projects/shared/public",
                  "output": "/"
                },
                {
                  "glob": "config.json",
                  "input": "projects/customer-portal/config/mock",
                  "output": "/"
                }
              ],
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            },
            "gateway": {
              "assets": [
                {
                  "glob": "**/*",
                  "input": "projects/customer-portal/public"
                },
                {
                  "glob": "**/*",
                  "input": "projects/shared/i18n",
                  "output": "i18n/shared"
                },
                {
                  "glob": "config.json",
                  "input": "projects/customer-portal/config/gateway",
                  "output": "/"
                }
              ],
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "options": {
            "port": 4201
          },
          "configurations": {
            "production": {
              "buildTarget": "customer-portal:build:production"
            },
            "development": {
              "buildTarget": "customer-portal:build:development"
            },
            "gateway": {
              "buildTarget": "customer-portal:build:gateway",
              "proxyConfig": "proxy.conf.json"
            }
          },
          "defaultConfiguration": "development"
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "tsConfig": "projects/customer-portal/tsconfig.spec.json",
            "runner": "vitest"
          }
        },
        "lint": {
          "builder": "@angular-eslint/builder:lint",
          "options": {
            "lintFilePatterns": [
              "projects/customer-portal/**/*.ts",
              "projects/customer-portal/**/*.html"
            ]
          }
        }
      }
    },
